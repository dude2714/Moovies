<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.Light.DarkActionBar">
        <item name="android:windowBackground">@color/colorAccent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="buttonTint">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="AppTheme.CheckBox" parent="@style/AppTheme">
        <item name="colorAccent">@color/color_focus</item>
    </style>
    <style name="Dialog_Link" parent="@style/Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:colorBackground">@color/alert_dialog_background</item>
        <item name="android:textColorPrimary">@color/alert_dialog_text_color</item>
        <item name="android:windowBackground">@color/alert_dialog_background</item>
        <item name="android:background">@color/alert_dialog_background</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
    </style>
    <style name="LinkTheme" parent="@style/Theme.MaterialComponents.Light.DarkActionBar">
        <item name="android:windowBackground">@color/colorAccent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:iconPreview">@drawable/ic_launcher</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="android:textCursorDrawable">@drawable/edt_cursor_drawable</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="MyCustomTextAppearance" parent="@style/TextAppearance.Design.Tab">
        <item name="android:textSize">16.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="PlayerTheme" parent="@style/Theme.AppCompat.Light.DarkActionBar">
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="actionBarTheme">@style/ActionBarTheme</item>
        <item name="colorAccent">@android:color/black</item>
        <item name="colorControlNormal">@android:color/white</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="ProgressDialog" parent="@style/Theme.AppCompat.Light.Dialog">
        <item name="android:textColorPrimary">#ff2d2d2d</item>
    </style>
    <style name="ProgressDialogAhi" parent="@style/Theme.AppCompat.Light.Dialog">
        <item name="android:textColorPrimary">#ffffffff</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:background">@color/drawer_background</item>
        <item name="colorAccent">@color/blue_real</item>
    </style>
    <style name="Theme.AppCompat.DayNight" parent="@style/Theme.AppCompat" />
    <style name="Theme.AppCompat.DayNight.DarkActionBar" parent="@style/Theme.AppCompat" />
    <style name="Theme.AppCompat.DayNight.Dialog" parent="@style/Theme.AppCompat.Dialog" />
