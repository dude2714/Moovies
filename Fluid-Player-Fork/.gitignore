.gradle/
.cache/

# Dependencies (if using dependency management)
libs/
vendor/

# Backups outside of fork (optional)
*-BACKUP/
*-backup/
*.tar.gz
*.zip

# Build outputs - not needed in repo
build/
out/
target/
dist/

# Generated files
*.gen
*.generated

# Do NOT include original APK files
Moovies-*.apk
Terrarium-TV-*.apk

# Process lock files
.lock
*.lock

# Prevent merging with parent Moovies repository
/..
/.git
